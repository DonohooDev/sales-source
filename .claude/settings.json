{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  },
  "enabledMcpjsonServers": [],
  "enableAllProjectMcpServers": true,
  "permissions": {
    "defaultMode": "default",
    "deny": [],
    "ask": [
      "Bash(git push -u origin main)",
      "Bash(git push main)",
      "Bash(git push)",
      "Bash(git reset --hard*)",
      "Bash(npm install*)",
      "Bash(pip install*)",
      "Bash(docker *)"
    ],
    "allow": ["WebFetch", "WebSearch", "Glob", "Grep", "mcp__MCP_DOCKER__*"]
  }
}
